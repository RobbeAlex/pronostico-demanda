/Type /StructElem
/S /P
/E (def fleury\(grafo_original\):  grafo = {k: v[:] for k, v in grafo_original.items\(\)}  grados_impares = [v for v in grafo if len\(grafo[v]\) % 2 == 1]  if len\(grados_impares\) not in [0, 2]: return None  inicio = grados_impares[0] if grados_impares else list\(grafo.keys\(\)\)[0]  camino = [inicio]  actual = inicio  while any\(grafo[v] for v in grafo\):  for vecino in grafo[actual][:]:  if len\(grafo[actual]\) == 1 or not es_puente\(grafo, actual, vecino\):  grafo[actual].remove\(vecino\)  grafo[vecino].remove\(actual\)  camino.append\(vecino\)  actual = vecino  break  return camino)
/Pg 13 0 R
/K [17 18]
>>
endobj
